runtime/
.undodir/
local.fish

# Python caches
__pycache__/
*.py[cod]

# macOS metadata
.DS_Store

# pi local state/secrets
pi/.pi/agent/auth.json
pi/.pi/agent/settings.json
pi/.pi/agent/trust.json
pi/.pi/agent/run-history.jsonl
pi/.pi/agent/models-store.json
pi/.pi/agent/sessions/
pi/.pi/agent/APPEND_SYSTEM.md
evals/

# machine-local helpers
fish/.config/fish/functions/mount-nas.fish

# pi debug log
pi/.pi/agent/pi-debug.log

# claude code: allow only the hand-written config, never the local state.
# This is a whitelist, so a new file that claude code writes into the package
# can never reach a commit by accident.
claude/.claude/*
!claude/.claude/CLAUDE.md
!claude/.claude/settings.json
!claude/.claude/plugins/
claude/.claude/plugins/*
!claude/.claude/plugins/known_marketplaces.json

# Codex: track shared instructions and explicit skill links.
codex/.codex/*
!codex/.codex/AGENTS.md
!codex/.codex/skills/
codex/.codex/skills/*
!codex/.codex/skills/codex-review-code
!codex/.codex/skills/codex-review-plan
!codex/.codex/skills/homeassistant
!codex/.codex/skills/ruby-testing
!codex/.codex/skills/skill-creation
!codex/.codex/skills/testing-principles
!codex/.codex/skills/orchestrate-tickets
!codex/.codex/skills/herdr-pane-mute

# Antigravity: track only the shared instructions link. The installer
# links skills/ and rules/local.md on each machine.
antigravity/.gemini/*
!antigravity/.gemini/config/
antigravity/.gemini/config/*
!antigravity/.gemini/config/AGENTS.md

# machine-generated files of the new packages. ~/.config/hypr/monitors.lua
# writes the ghostty file, and btop and micro write their own folders.
ghostty/.config/ghostty/hypr-background-opacity.conf
btop/.config/btop/themes/
micro/.config/micro/colorschemes/
micro/.config/micro/syntax/
micro/.config/micro/plug/
micro/.config/micro/buffers/

# hypr: these describe the hardware of one machine, so they stay local.
hypr/.config/hypr/monitors.lua
hypr/.config/hypr/devices.lua
hypr/.config/hypr/plugins/

# Repo-owned shared skills exposed to Claude.
!claude/.claude/skills/
claude/.claude/skills/*
!claude/.claude/skills/homeassistant
!claude/.claude/skills/skill-creation
!claude/.claude/skills/testing-principles
!claude/.claude/skills/ruby-testing
!claude/.claude/skills/codex-review-code
!claude/.claude/skills/codex-review-plan
!claude/.claude/skills/orchestrate-tickets
!claude/.claude/skills/herdr-pane-mute
