# Name, email and signing key stay out of this repository.
# Put them into ~/.gitconfig.local on each machine:
#   [user]
#       name = Your Name
#       email = you@example.com
[include]
	path = ~/.gitconfig.local
[core]
    pager = delta
	autocrlf = input

[interactive]
    diffFilter = delta --color-only

[include]
    path = ~/.config/delta/themes/catppuccin.gitconfig
[delta]
    navigate = true    # use n and N to move between diff sections
    features = catppuccin-mocha
    # delta detects terminal colors automatically; set one of these to disable auto-detection
    # dark = true
    # light = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
  rebase = true
[gpg]
	format = ssh
[init]
	defaultBranch = main
[credential]
	helper = store
[rerere]
	enabled = true
