# macOS system layer only, like paru.fish on Arch. Language runtimes and
# CLI tools come from mise, so they are deliberately absent here: node,
# python, go, ruby, erlang, elixir, delta, lazygit, lazydocker, eza, zoxide,
# ripgrep, fd, fzf, bat, yazi, yq, taplo, starship, neovim, gh, uv.
# See mise/.config/mise/config.toml.

# Shell. macOS ships zsh; the dotfiles need fish.
brew "fish"
# Claude Code runs its Bash tool in this bash (CLAUDE_CODE_SHELL in
# config.fish). macOS /bin/bash is 3.2, which Claude Code rejects as too old.
brew "bash"

# Bootstrap: stow links this repo, mise installs everything else.
brew "stow"
brew "mise"

# Erlang build dependencies. mise compiles Erlang from source, so these
# must exist before `mise install` runs. make and the C compiler come
# from the Xcode Command Line Tools, which the Homebrew installer adds.
brew "autoconf"
brew "openssl@3"
brew "wxwidgets"
brew "libxslt"
brew "fop"
brew "unixodbc"

# Provide rustup for mise to install and update Rust toolchains.
brew "rustup"

# SSH security keys. config.fish starts Homebrew ssh-agent so `ssh-add -K`
# can hold FIDO (sk) keys; Apple's /usr/bin/ssh-agent ignores libfido2.
brew "libfido2"
brew "openssh"

# System and developer tools not managed by mise
brew "btop"
brew "displayplacer"
brew "glab"
brew "tree-sitter-cli"
brew "watchman"
brew "cocoapods"
brew "xcodes"

# Database and media libraries for local projects
brew "postgresql@17", restart_service: :changed, link: true
brew "libpq"
brew "vips"
brew "ghostscript"

# Terminal. On Arch this is "paru -S ghostty" instead.
cask "ghostty"

# Tiling window manager. The macOS counterpart of hyprland on Arch.
tap "nikitabobko/tap"
cask "nikitabobko/tap/aerospace"

# Window borders for AeroSpace. Hyprland draws borders itself on Arch.
# install.fish starts the service after stow links ~/.config/borders/bordersrc.
tap "FelixKratz/formulae"
brew "FelixKratz/formulae/borders"

# Key remapping and Dygma Defy firmware configurator.
# install.fish generates ~/.config/karabiner/karabiner.json after stowing.
cask "karabiner-elements"
cask "bazecor"

# Containers, mobile SDKs, and desktop utilities
cask "docker-desktop"
cask "android-studio"
cask "android-commandlinetools"
cask "cyberduck"
cask "localsend"
cask "nextcloud"
