# Ghostty configuration.
#
# Linux and macOS both read $XDG_CONFIG_HOME/ghostty/config, which is
# ~/.config/ghostty/config. One stowed file therefore serves both machines.
# macOS reads ~/Library/Application Support/com.mitchellh.ghostty/config after
# this file, but that file is not necessary.
#
# Ghostty ignores an option that its platform does not support, so the macOS
# options and the Linux options can stay together in this file.
#
# Read the full option list with "ghostty +show-config --default --docs", or at
# https://ghostty.org/docs/config/reference

# Ghostty has its own default colors: a #282c34 background, a #ffffff
# foreground and a palette with low saturation. kitty had a #000000 background
# and strong colors. This difference makes Ghostty look pale, and the wallpaper
# behind the 0.7 opacity makes it look paler again.
#
# Catppuccin Mocha is also the theme of Neovim (nvim/lua/plugins/color.lua) and
# of starship, so this line gives the three programs the same colors.
#
# The value must be the exact file name in /usr/share/ghostty/themes, together
# with the capital letters and the space. Read the list of names with
# "ghostty +list-themes".
theme = Catppuccin Mocha

# Catppuccin Mocha uses #1e1e2e ("base") for the background. Behind the 0.7
# opacity a bright wallpaper still makes that color pale. #11111b ("crust") is
# the darkest color of the theme and keeps the window dark. Remove this line to
# get the standard background of the theme.
background = #11111b

background-opacity = 0.7

# Ghostty supplies JetBrains Mono itself, so both machines show the same font.
font-family = JetBrains Mono

# ssh-terminfo copies the Ghostty terminfo to a remote host at the first
# connection. Without it the host does not know TERM=xterm-ghostty. ssh-env
# sets TERM=xterm-256color for a host that refuses the copy.
#
# These two names are added to the default features. To switch a default off,
# give its name with a "no-" prefix, for example "no-cursor".
shell-integration-features = ssh-env,ssh-terminfo

# Ghostty shows a confirmation before it closes a terminal that still runs a
# process. On macOS that confirmation is a native dialog, and the dialog takes
# the focus away from the keyboard. Ghostty has no option to draw the question
# in the terminal window, so "false" is the only way to remove the dialog.
#
# The other permitted values are "true" (the default: ask when shell
# integration reports a running process) and "always" (ask every time).
confirm-close-surface = false

# macOS keeps an application running after its last window closes, and Ghostty
# follows that rule: "exit" closes the window, but Ghostty stays in the Dock.
# This line makes Ghostty quit when the last terminal closes, so "exit" ends
# the program. Linux quits after the last window without this option, and so
# ignores it.
#
# quit-after-last-window-closed-delay (for example "5s") keeps Ghostty alive
# for a short time, so that a new window opens faster. This file does not set
# it, so Ghostty quits at once.
quit-after-last-window-closed = true

# macOS only. Linux ignores this line. It makes the Option key send Alt, so
# the readline and fish word bindings work.
#
# "left", not "true": "true" takes both Option keys, and then Ghostty eats
# the right Option as well. The Defy needs the right one as AltGr, because
# Karabiner builds the Linux symbol layer on it (@ { } [ ] \ | ~, see
# ~/.config/karabiner/generate-defy-rules.py). With "true" those characters
# do not reach the terminal.
#
# The left Option keeps its Alt behaviour for the MacBook keyboard. On the
# Defy, Karabiner already turns the left Option into an ESC prefix, so this
# line only matters for the built-in keyboard.
macos-option-as-alt = left

# Shift+Enter makes a new line in Claude Code instead of sending the input.
# ESC CR is what Alt+Enter sends, and "text:" writes both bytes at once.
#
# Ghostty sends only CR for Shift+Enter by default, which submits the line.
# This line must be the ONLY handler of the key. Karabiner must not remap
# Shift+Enter (see generate-defy-rules.py, TERM_SHORTCUTS): Karabiner sends
# key events, so its Escape becomes "CSI 27 u" under the Kitty keyboard
# protocol, which Claude Code reads as the Escape key and then submits.
# "text:" writes the two raw bytes, and it works on both keyboards.
#
# The left Option key also works, through macos-option-as-alt above. The
# right Option does NOT, because it is the AltGr key for @ { } [ ] \ | ~.
keybind = shift+enter=text:\x1b\r

# hypr-background-opacity.conf is NOT in this repository. ~/.config/hypr/
# monitors.lua writes that file, and monitors.lua stays out of the repository
# because it describes the monitors of one machine. The "?" makes the file
# optional, so this configuration also works on a machine without Hyprland.
config-file = ?hypr-background-opacity.conf
