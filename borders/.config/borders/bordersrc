#!/bin/bash

# Configuration for JankyBorders (the "borders" brew formula). The borders
# binary runs this file at startup. The brew service starts the binary, so
# a change here needs: brew services restart borders
#
# The colors copy the Hyprland border colors (hypr/.config/hypr/hyprland.lua):
# an active window gets a cyan-to-green gradient, an inactive window gets
# gray. The color format is 0xAARRGGBB.
options=(
	style=round
	width=6.0
	hidpi=on
	active_color="gradient(top_left=0xee33ccff,bottom_right=0xee00ff99)"
	inactive_color=0xaa595959
)

borders "${options[@]}"
